{
  "name": "alfred",
  "version": "2026.11.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run changelog:gen && { chokidar changelog.json -c 'bun run changelog:gen' & trap \"kill $!\" EXIT; wxt; }",
    "dev:firefox": "wxt -b firefox",
    "build": "rm -rf .output && bun run changelog:gen && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "rm -rf .output && wxt zip && open .output",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check": "svelte-check --threshold error",
    "check:watch": "svelte-check --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "changelog:gen": "bun scripts/generate-changelog.ts",
    "deploy:worker": "wrangler d1 migrations apply alfred-events --remote -c worker/wrangler.jsonc && wrangler deploy -c worker/wrangler.jsonc",
    "testpages": "bun test-pages/server.ts",
    "submit": "bash scripts/submit.sh",
    "prepare": "h=$(git rev-parse --git-path hooks) && cp scripts/pre-commit \"$h/pre-commit\" && chmod +x \"$h/pre-commit\"",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@shopify/app-bridge-ui-types": "^0.3.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@wxt-dev/auto-icons": "^2.0.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "chokidar-cli": "^3.0.0",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "web-ext": "^10.8.0",
    "wrangler": "^4.166.0",
    "wxt": "^0.21.5"
  },
  "packageManager": "bun@1.4.2"
}
